<?xml version="1.0" encoding="utf-8"?>
<!-- The notification open: the night scene of the status card on the right
     (faded to the card's colour at its left and top edges, so it has no
     edge here either), the state, the server, the clock, and three pills.
     Android 12 and later start this view under the app's name and keep the
     column under its icon, some 73dp, for themselves: nothing drawn there
     is shown. In a dark shade, with no card, the words start where the
     app's name does and as much is left free on the right (values-night's
     `note_start`, `note_end`), which sets the content in the notification's
     middle with the scene in the room on the right; measured on the user's
     Pixel 7. A light shade keeps the card and the same room on both sides
     inside it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/note_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/picture"
        android:layout_width="wrap_content"
        android:layout_height="132dp"
        android:layout_gravity="end|top"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/note_picture" />

    <ImageView
        android:layout_width="170dp"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/note_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/note_start"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/note_end"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_pink" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="#EE82C4"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxWidth="210dp"
            android:singleLine="true"
            android:textColor="#EFE8F5"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clock_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B5A9C4"
                android:textSize="13sp" />

            <Chronometer
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#D3C9DD"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B5A9C4"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Three pills of one width: at their own widths «Отключить» was
             pushed past the edge and wrapped out of sight on the user's phone. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/first"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/note_pill"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#EE82C4"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/second"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/note_pill_quiet"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#D3C9DD"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/third"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/note_pill_quiet"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#D3C9DD"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
